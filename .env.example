OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set these values in Netlify Site configuration, not in committed files.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Auth access token must be supplied by the authenticated server session.
# 최초 유료 호출 승인 전에는 false 유지
OFFICE_ALLOW_LOCAL_LIVE=false
OFFICE_PAID_CALLS_APPROVED=false
# API 키와 다른 로컬 관리자 비밀번호 (16자 이상)
OFFICE_ADMIN_PASSWORD=
OFFICE_MAX_INPUT_TOKENS=8000
OFFICE_MAX_OUTPUT_TOKENS=600
OFFICE_MAX_ATTEMPTS=2
OFFICE_MAX_RUN_CALLS=8
OFFICE_TIMEOUT_MS=20000
# 다른 모델은 공식 가격 확인 후 단가를 명시해야 합니다.
# OFFICE_INPUT_USD_PER_MILLION=0.40
# OFFICE_OUTPUT_USD_PER_MILLION=1.60

# 6-1: 유료 API는 이전 플래그와 무관하게 차단됩니다.
# 최초 실제 Codex 실행에 대한 별도 승인 전 false 유지
OFFICE_CODEX_FIRST_RUN_APPROVED=false
# 자동 탐지가 실패할 때만 공식 Windows 실행 파일의 절대 경로 지정
# OFFICE_CODEX_BINARY=C:/.../codex.exe

# ── 공개 배포와 내 PC 작업장 가르기 ───────────────────────────
# 1 로 두면 AI 오피스(/office)와 사무실 API 가 라우트로 빌드됩니다.
# 내 PC 의 .env.local 에만 넣습니다. Netlify 에는 넣지 마세요.
# 넣지 않으면 공개용(AI 동화 전용) 빌드가 됩니다.
NEXT_PUBLIC_OFFICE_LOCAL=

# 동화 생성 유료 호출 승인. '1' 일 때만 켜집니다.
# 키가 환경에 있다는 이유만으로 켜지지 않게 하는 안전장치입니다.
# 공개 배포에서는 넣지 마세요. 넣는 순간 방문자가 생성을 돌릴 수 있고 과금됩니다.
OFFICE_STORY_GENERATION_APPROVED=
