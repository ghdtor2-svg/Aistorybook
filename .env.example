OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set these values in Netlify Site configuration, not in committed files.

# 내 PC 전용 주문 백오피스(/office/orders)의 관리자 비밀번호. API 키와 다르게, 16자 이상.
OFFICE_ADMIN_PASSWORD=

# Local Toss Payments test store API keys (use test_ck_ and test_sk_ only).
NANGMAN_TOSS_CLIENT_KEY=
NANGMAN_TOSS_SECRET_KEY=

# Optional cloud connection; keep off until production deployment and shared storage are verified.
# Netlify production Functions runtime only: do not set NEXT_PUBLIC_OFFICE_LOCAL.
NANGMAN_STORAGE=local
NANGMAN_CLOUD_ENABLED=0
NANGMAN_PUBLIC_URL=https://nangman-hanjul.netlify.app
NANGMAN_ADMIN_BRIDGE_SECRET=
NANGMAN_WORKER_SECRET=
# Owner PC only, after signed online readiness verification:
NANGMAN_REMOTE_URL=
